  "item": [
    {
      "name": "0. Auth (Login, Register, Refresh, Me)",
      "item": [
        {
          "name": "0.1 Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.have.property('accessToken').and.to.be.a('string').and.not.empty;",
                  "pm.expect(data).to.have.property('refreshToken').and.to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('adminAccess', data.accessToken);",
                  "pm.collectionVariables.set('adminRefresh', data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"deviceId\": \"postman-admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "0.2 Register Seller + Fetch ID via /me",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('sellerUsername', 'seller_' + ts);",
                  "pm.collectionVariables.set('sellerEmail', 'seller_' + ts + '@example.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const tokens = pm.response.json();",
                  "pm.expect(tokens).to.have.property('accessToken').and.not.empty;",
                  "pm.expect(tokens).to.have.property('refreshToken').and.not.empty;",
                  "pm.collectionVariables.set('sellerAccess', tokens.accessToken);",
                  "pm.collectionVariables.set('sellerRefresh', tokens.refreshToken);",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/auth/me',",
                  "  method: 'GET',",
                  "  header: { 'Authorization': 'Bearer ' + tokens.accessToken }",
                  "}, function (err, res) {",
                  "  pm.expect(err).to.be.null;",
                  "  pm.expect(res.code).to.eql(200);",
                  "  const me = res.json();",
                  "  pm.collectionVariables.set('sellerId', me.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{sellerUsername}}\",\n  \"email\": \"{{sellerEmail}}\",\n  \"password\": \"{{sellerPassword}}\",\n  \"deviceId\": \"postman-seller\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "0.3 Register Buyer + Fetch ID via /me",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now() + 1;",
                  "pm.collectionVariables.set('buyerUsername', 'buyer_' + ts);",
                  "pm.collectionVariables.set('buyerEmail', 'buyer_' + ts + '@example.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const tokens = pm.response.json();",
                  "pm.expect(tokens).to.have.property('accessToken').and.not.empty;",
                  "pm.expect(tokens).to.have.property('refreshToken').and.not.empty;",
                  "pm.collectionVariables.set('buyerAccess', tokens.accessToken);",
                  "pm.collectionVariables.set('buyerRefresh', tokens.refreshToken);",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/auth/me',",
                  "  method: 'GET',",
                  "  header: { 'Authorization': 'Bearer ' + tokens.accessToken }",
                  "}, function (err, res) {",
                  "  pm.expect(err).to.be.null;",
                  "  pm.expect(res.code).to.eql(200);",
                  "  const me = res.json();",
                  "  pm.collectionVariables.set('buyerId', me.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{buyerUsername}}\",\n  \"email\": \"{{buyerEmail}}\",\n  \"password\": \"{{buyerPassword}}\",\n  \"deviceId\": \"postman-buyer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "0.4 Get Current User (/api/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.username).to.eql(pm.collectionVariables.get('adminUsername'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminAccess}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Сценарий ротации и сессий (5 шагов задания)",
      "item": [
        {
          "name": "Step 1: POST /api/auth/login (сохраняем первую пару)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
                  "pm.expect(data.refreshToken).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('adminAccess', data.accessToken);",
                  "pm.collectionVariables.set('rotFirstRefresh', data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"deviceId\": \"scenario-5-steps\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Step 2: Защищённый endpoint с accessToken -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Protected endpoint returns 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminAccess}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Step 3: POST /api/auth/refresh (новая пара, строки отличаются)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refresh returns 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "const oldRefresh = pm.collectionVariables.get('rotFirstRefresh');",
                  "const oldAccess = pm.collectionVariables.get('adminAccess');",
                  "pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
                  "pm.expect(data.refreshToken).to.be.a('string').and.not.empty;",
                  "pm.expect(data.refreshToken).to.not.eql(oldRefresh);",
                  "pm.expect(data.accessToken).to.not.eql(oldAccess);",
                  "pm.collectionVariables.set('rotSecondRefresh', data.refreshToken);",
                  "pm.collectionVariables.set('rotSecondAccess', data.accessToken);",
                  "pm.collectionVariables.set('adminAccess', data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{rotFirstRefresh}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Step 4: Повторный старый refreshToken -> 401 без новой пары",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reused refresh returns 401', function () { pm.response.to.have.status(401); });",
                  "const body = pm.response.json();",
                  "pm.expect(body).to.not.have.property('accessToken');",
                  "pm.expect(body).to.not.have.property('refreshToken');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{rotFirstRefresh}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Step 5: Напоминание проверки БД (pgAdmin / psql)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Check user_sessions in DB: row 1 REVOKED, row 2 ACTIVE, no row 3', function () { pm.expect(true).to.be.true; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{rotSecondAccess}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
